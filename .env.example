ENVIRONMENT=development
LOG_LEVEL=INFO

# Server 1
SERVER1_DATABASE_URL=postgresql+asyncpg://barcodes:barcodes@postgres_server1:5432/barcodes_server1
SERVER1_REDIS_URL=redis://redis_server1:6379/0

# Server 2
SERVER2_DATABASE_URL=postgresql+asyncpg://barcodes:barcodes@postgres_server2:5432/barcodes_server2
SERVER2_REDIS_URL=redis://redis_server2:6379/0

# Worker
CELERY_BROKER_URL=redis://redis_server1:6379/0
CELERY_RESULT_BACKEND=redis://redis_server1:6379/1
AI_PROVIDER=deterministic
AI_PROMPT_VERSION=product-v1
IMAGE_STORAGE_ROOT=/data/barcodes
IMAGE_PUBLIC_BASE_URL=http://localhost:8001/media

# Enabled in W5 when Server 2's idempotent receiver is available.
SERVER2_INTERNAL_URL=http://public_api:8000
INTERNAL_SYNC_SECRET=replace-with-a-long-random-secret
CURSOR_SIGNING_SECRET=replace-with-an-independent-long-random-secret
# Optional previous key during a controlled rotation window (leave blank normally).
CURSOR_PREVIOUS_SIGNING_SECRET=
PRODUCT_CACHE_TTL_SECONDS=300
DAILY_REQUEST_LIMIT=1000
MONTHLY_UNIQUE_PRODUCT_LIMIT=100
RATE_LIMIT_FAIL_OPEN=true
CHANGES_DEFAULT_LIMIT=100
CHANGES_MAX_LIMIT=1000
CHANGES_RETENTION_DAYS=365
